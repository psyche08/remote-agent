# Local runtime / secrets. Keep this file self-contained: remote-coding may be
# published as its own repository, so the parent monorepo ignore rules do not
# apply.
.venv/
config.json
bin/
data/
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.mobileprovision
*.log
*.jsonl
.DS_Store

# Manual signed/notarized release artifacts. The root build.sh keeps every
# generated binary, bundle, archive, manifest, and notarization receipt here.
/build/

# generated screenshots (keep the dir via .gitkeep)
screenshots/*.png
!screenshots/.gitkeep

# generated Authorization Plug-in output (formal builds use the root build.sh)
mac/authorization-plugin/build/

# test/tool caches
.pytest_cache/
__pycache__/
*.pyc

# SwiftPM build products for the macOS helper
mac/RemoteAgentDesktop/.build/
