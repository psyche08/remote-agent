{
  "device_id": "mac-studio-01",
  "devices": ["mac-studio-01", "mac-pro-02"],
  "host": "127.0.0.1",
  "port": 8765,
  "uds": "/opt/private-tunnel/state/remote-agent/sockets/backend.sock",
  "state_dir": "/opt/private-tunnel/state/remote-agent",
  "push_proxy": "",
  "push_vapid": null,
  "default_provider": "claude",
  "computer_use": {
    "enabled": false,
    "helper_socket": "~/Library/Application Support/remote-agent/desktop.sock",
    "locked_use": {
      "enabled": false,
      "grant_ttl_seconds": 10,
      "window_ttl_seconds": 300,
      "input_relock_grace_ms": 250,
      "require_display_shield": true
    }
  },
  "providers": {
    "claude": {
      "app_name": "Claude",
      "command": "claude",
      "cwd": "~/Developer",
      "permission_mode": "auto",
      "turnstate_dir": "~/.claude/remote-agent-turnstate",
      "kill_grace": 3
    },
    "codex": {
      "app_name": "Codex",
      "command": "codex",
      "cwd": "~/Developer"
    },
    "terminal-agent": {
      "type": "pty",
      "app_name": "Terminal Agent",
      "command": "agent-cli",
      "args": ["--interactive"],
      "cwd": "~/Developer",
      "prompt_suffix": "\r",
      "interrupt_sequence": "\u0003",
      "idle_timeout_ms": 1500,
      "ready_pattern": "(?m)^> $",
      "allow_raw_keys": false,
      "max_output_bytes": 262144,
      "max_sessions": 32
    }
  }
}
