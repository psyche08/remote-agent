<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The data-protection keychain the unlock credential is stored in requires
       an access group. Scoping it to this helper's Team ID + a private group,
       and never sharing the group, is what binds the credential to this signed
       binary: no other process, even of the same user, can read the item. This
       is the "ACL bound to code signature" hardening the design requires.
       The prefix is the literal Team ID (89LGY6BD53): $(AppIdentifierPrefix)
       needs a provisioning profile to resolve, which a Developer-ID-signed
       standalone helper does not have, and an ad-hoc build carrying an
       unresolved group is killed at launch (SIGKILL) by platform policy. -->
  <key>keychain-access-groups</key>
  <array>
    <string>89LGY6BD53.com.psyche08.remote-agent.locked-use</string>
  </array>
</dict>
</plist>
